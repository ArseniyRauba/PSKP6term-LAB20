<div class="container">

<h1>Изменить запись</h1>

<div class="phone-list">

{{#each phones}}
<a class="phone-row" style="pointer-events:none; opacity:0.6;">
{{name}} <br> {{phone}}
</a>
{{/each}}

</div>

<form method="POST" action="/Update">

<input type="hidden" name="id" value="{{phone.id}}">

<input name="name" value="{{phone.name}}">
<input name="phone" value="{{phone.phone}}">

<button type="submit">Изменить</button>

</form>

<form method="POST" action="/Delete">

<input type="hidden" name="id" value="{{phone.id}}">

<button type="submit">Удалить</button>

</form>

<a class="add-btn" href="/">Отказаться</a>

</div>