<div class="container">

<h1>Изменить запись</h1>

<div class="phone-list">

{{#each phones}}
{{> phoneRow}}
{{/each}}

</div>

<form method="POST" action="/Update">

<input type="hidden" name="id" value="{{phone.id}}">

<input id="name" name="name" value="{{phone.name}}">
<input id="phone" name="phone" value="{{phone.phone}}">

<button type="submit">Изменить</button>

</form>

<form method="POST" action="/Delete">

<input type="hidden" name="id" value="{{phone.id}}">

<button id="deletebtn" type="submit">Удалить</button>

</form>

<a class="add-btn" href="/">Отказаться</a>

</div>

<script>
    const nameInput = document.getElementById("name");
    const phoneInput = document.getElementById("phone");
    const deleteBtn = document.getElementById("deletebtn");

    function disableDelete() {
        deleteBtn.disabled = true;
    }

    nameInput.addEventListener("input", disableDelete);
    phoneInput.addEventListener("input", disableDelete);
</script>